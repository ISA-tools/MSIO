AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OBI_0600024> "OBI branch derived"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0600024> "maintaining cell culture"@en)
