AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/IAO_0000184> "scattergraph"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/IAO_0000184> "WEB: http://en.wikipedia.org/wiki/Scatterplot"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/IAO_0000184> "scatter plot"@en)
