AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/RO_0002297> "GOC:mtg_berkeley_2013")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002297> "results in formation of anatomical entity"@en)
