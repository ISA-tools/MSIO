AnnotationAssertion(obo:IAO_0000114 obo:MSIO_0000122 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000122 "a process of collecting a sample when the cells of a cell culture growth are not dividing"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000122 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000122 "EU H2020 PhenoMenAl"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000122 "cosmos tracer based metabolomics working group"@en)
AnnotationAssertion(rdfs:label obo:MSIO_0000122 "collection at cytostatic phase"@en)
SubClassOf(obo:MSIO_0000122 obo:OBI_0000659)

