AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000126 "a process of collecting a sample when the cell culture growth has reached a plateau, indicative of a steady state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000126 "Alejandra Gonzalez-Beltran")
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000126 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000118 obo:MSIO_0000126 "collection at steady state phase"@en)
