AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000182 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000182 "cosmos tracer based metabolomics working group"@en)
