AnnotationAssertion(obo:IAO_0000114 obo:MSIO_0000030 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000030 ""@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000030 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000118 obo:MSIO_0000030 "QDA reagent"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000030 ""@en)
