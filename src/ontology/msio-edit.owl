# Class: obo:MSIO_0000143 (polar metabolite extraction)

AnnotationAssertion(obo:IAO_0000114 obo:MSIO_0000143 obo:IAO_0000122)
AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000143 "polar metabolite extraction is a metabolite extraction which aims to retrieve water soluble or metabolites with polar solvent solubility properties. This is usually exclusive of hydrophobique, lipophile and lipid like metabolites."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000143 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000143 "EU H2020 PhenoMenAl"@en)
AnnotationAssertion(rdfs:label obo:MSIO_0000143 "polar metabolite extraction"@en)
