SubClassOf(obo:MSIO_0000038 ObjectSomeValuesFrom(obo:OBI_0000312 obo:MSIO_0000120))

# Class: obo:MSIO_0000039 (partial isotopomer)

AnnotationAssertion(obo:IAO_0000114 obo:MSIO_0000039 obo:IAO_0000428)
AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000039 "an isotopomer where the isotopic content of specific atoms is known for a part of the molecule")
AnnotationAssertion(obo:IAO_0000116 obo:MSIO_0000039 "should it be a relation or a class?"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000039 "Philippe Rocca-Serra"@en)
