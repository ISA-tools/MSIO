AnnotationAssertion(obo:IAO_0000115 obo:MSIO_0000142 "lipid extraction is an extraction which aims to retrieve lipid (hydrophobic carbohydrate) from a specimen"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MSIO_0000142 "Philippe Rocca-Serra"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MSIO_0000142 "EU H2020 PhenoMenAl"@en)
