SubClassOf(obo:MSIO_0000079 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MSIO_0000060))
SubClassOf(obo:MSIO_0000079 ObjectMinCardinality(1 obo:IAO_0000136 obo:MSIO_0000001))

